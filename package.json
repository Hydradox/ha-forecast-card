{
  "name": "ha-forecast-card",
  "version": "1.2.0",
  "description": "Home Assistant Lovelace card to preview weather forecasts and key weather attributes",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:ha": "bash dev/ha.sh up",
    "dev:ha:down": "bash dev/ha.sh down",
    "dev:ha:logs": "bash dev/ha.sh logs",
    "dev:ha:reset": "bash dev/ha.sh reset"
  },
  "engines": {
    "node": ">=22.14"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.92.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "conventional-changelog-writer": "^9.3.0"
  }
}
